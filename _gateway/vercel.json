{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/blog", "destination": "https://onttle-examples-blog.vercel.app/blog" },
    { "source": "/blog/:path*", "destination": "https://onttle-examples-blog.vercel.app/blog/:path*" },
    { "source": "/help-center", "destination": "https://onttle-examples-help-center.vercel.app/help-center" },
    { "source": "/help-center/:path*", "destination": "https://onttle-examples-help-center.vercel.app/help-center/:path*" },
    { "source": "/i18n-landing", "destination": "https://onttle-examples-i18n-landing.vercel.app/i18n-landing" },
    { "source": "/i18n-landing/:path*", "destination": "https://onttle-examples-i18n-landing.vercel.app/i18n-landing/:path*" },
    { "source": "/feedback-board", "destination": "https://onttle-examples-feedback-board.vercel.app/feedback-board" },
    { "source": "/feedback-board/:path*", "destination": "https://onttle-examples-feedback-board.vercel.app/feedback-board/:path*" },
    { "source": "/event-rsvp", "destination": "https://onttle-examples-event-rsvp.vercel.app/event-rsvp" },
    { "source": "/event-rsvp/:path*", "destination": "https://onttle-examples-event-rsvp.vercel.app/event-rsvp/:path*" }
  ]
}
