# Onttle (server only — do not add the NEXT_PUBLIC_ prefix)
ONTTLE_API_URL=https://api.onttle.com/v1
ONTTLE_PROJECT_ID=
# Secret key (sk-proj_…). Every call is made on the server with it, including the search endpoints,
# which spend embedding / reranker tokens. Mark it Sensitive on Vercel.
ONTTLE_API_KEY=
# Table slug or id (the search paths take it too: /tables/photos/embeddings)
ONTTLE_PHOTOS_TABLE=photos
# Optional: "true" hides the search box behind a notice (public demo cost guard)
SEARCH_DISABLED=

# Absolute URL for metadata (includes the basePath /photo-portfolio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000/photo-portfolio
