# Onttle (server only — do not add the NEXT_PUBLIC_ prefix)
ONTTLE_API_URL=https://api.onttle.com/v1
ONTTLE_PROJECT_ID=
# Secret key (sk-proj_…). Every call is made on the server with it: registrations can only be read
# and written with a secret key (permission rules read/create `none`). Mark it Sensitive on Vercel.
ONTTLE_API_KEY=
# Table slugs or ids
ONTTLE_EVENTS_TABLE=events
ONTTLE_REGISTRATIONS_TABLE=registrations
# Signing key of the webhook `rsvp-seats` (Webhooks → rsvp-seats → Signing key). Sensitive.
ONTTLE_WEBHOOK_SIGNING_KEY=

# Absolute URL for metadata (includes the basePath /event-rsvp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000/event-rsvp
