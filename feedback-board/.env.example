# Onttle (server only — do not add the NEXT_PUBLIC_ prefix)
ONTTLE_API_URL=https://api.onttle.com/v1
ONTTLE_PROJECT_ID=
# Publishable key (pk-proj_…). Sent as X-Onttle-Key on every call; the table permission rules
# (read public · create member · update/delete owner) decide what a member token may do.
ONTTLE_PUBLISHABLE_KEY=
# Table slug or id
ONTTLE_FEEDBACK_TABLE=feedback

# Absolute URL for metadata (includes the basePath /feedback-board)
NEXT_PUBLIC_SITE_URL=http://localhost:3000/feedback-board
