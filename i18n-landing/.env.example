# Onttle (server only — do not add the NEXT_PUBLIC_ prefix)
ONTTLE_API_URL=https://api.onttle.com/v1
ONTTLE_PROJECT_ID=
# Publishable key (pk-proj_…): every call in this example is a GET. Still read on the server only.
ONTTLE_API_KEY=
# Table IDs (id_nano) used in /tables/{id}. The plans table has no slug, so IDs are used for both.
ONTTLE_FEATURES_TABLE_ID=
ONTTLE_PLANS_TABLE_ID=

# Any random string that protects /api/revalidate
REVALIDATE_SECRET=

# Absolute URL for hreflang and OG (includes the basePath /i18n-landing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000/i18n-landing
