# Onttle (server only — do not add the NEXT_PUBLIC_ prefix)
ONTTLE_API_URL=https://api.onttle.com
ONTTLE_PROJECT_ID=
# Secret key (sk-proj_…): BM25 search is a POST, so a publishable key will not work
ONTTLE_API_KEY=

# Any random string that protects /api/revalidate
REVALIDATE_SECRET=

# Absolute URL for RSS and OG (includes the basePath /blog)
NEXT_PUBLIC_SITE_URL=http://localhost:3000/blog
