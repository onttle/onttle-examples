# Onttle (server only — do not add the NEXT_PUBLIC_ prefix)
ONTTLE_API_URL=https://api.onttle.com
ONTTLE_PROJECT_ID=
# Secret key (sk-proj_…): Chats and Embeddings are POSTs, so a publishable key will not work
ONTTLE_API_KEY=
# Agent ID from the Agents menu (agent_id in Chats)
ONTTLE_AGENT_ID=
# faqs table ID: used in the list, item and embeddings paths (/tables/{id}) and in Chats tableIds
ONTTLE_FAQ_TABLE_ID=

# AI cost limits for the public demo
ASK_MAX_MESSAGE_LENGTH=300
ASK_MAX_TURNS=6
# Chats search type: vector | query | hybrid | bm25 (empty = hybrid)
ASK_SEARCH_TYPE=

# Any random string that protects /api/revalidate
REVALIDATE_SECRET=

# Absolute URL for OG (includes the basePath /help-center)
NEXT_PUBLIC_SITE_URL=http://localhost:3000/help-center
