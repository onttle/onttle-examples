# Onttle (서버 전용 — NEXT_PUBLIC_ 접두사를 붙이지 마세요)
ONTTLE_API_URL=https://api.onttle.com
ONTTLE_PROJECT_ID=
# 시크릿 키(sk-proj_…): Chats·Embeddings가 POST라 게시용 키로는 안 됩니다
ONTTLE_API_KEY=
# Agents 메뉴의 Agent ID (Chats의 agent_id)
ONTTLE_AGENT_ID=
# faqs 테이블 ID: 목록·단건·임베딩 경로(/tables/{id})와 Chats의 tableIds에 씁니다
ONTTLE_FAQ_TABLE_ID=

# 공개 데모 AI 비용 제한
ASK_MAX_MESSAGE_LENGTH=300
ASK_MAX_TURNS=6
# Chats 검색 방식: vector | query | hybrid | bm25 (비우면 hybrid)
ASK_SEARCH_TYPE=

# /api/revalidate 보호용 임의 문자열
REVALIDATE_SECRET=

# OG 절대 URL (basePath /help-center 포함)
NEXT_PUBLIC_SITE_URL=http://localhost:3000/help-center
